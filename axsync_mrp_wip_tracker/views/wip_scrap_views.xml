<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="axsync_wip_scrap_view_list" model="ir.ui.view">
        <field name="name">axsync.wip.scrap.list</field>
        <field name="model">axsync.wip.scrap</field>
        <field name="arch" type="xml">
            <tree string="Scrap Analysis" create="0" edit="0" delete="0">
                <field name="scrap_date"/>
                <field name="production_id"/>
                <field name="workorder_id" optional="hide"/>
                <field name="finished_product_id" optional="show"/>
                <field name="product_id"/>
                <field name="product_uom_id" optional="show"/>
                <field name="scrap_qty" sum="Total"/>
                <field name="scrap_value" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="axsync_wip_scrap_view_search" model="ir.ui.view">
        <field name="name">axsync.wip.scrap.search</field>
        <field name="model">axsync.wip.scrap</field>
        <field name="arch" type="xml">
            <search string="Search Scrap">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="finished_product_id"/>
                <filter name="last_30" string="Last 30 Days"
                        domain="[('scrap_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Scrapped Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'production_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'scrap_date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="axsync_wip_scrap_view_pivot" model="ir.ui.view">
        <field name="name">axsync.wip.scrap.pivot</field>
        <field name="model">axsync.wip.scrap</field>
        <field name="arch" type="xml">
            <pivot string="Scrap Analysis" sample="1">
                <field name="product_id" type="row"/>
                <field name="scrap_date" interval="month" type="col"/>
                <field name="scrap_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="axsync_wip_scrap_view_graph" model="ir.ui.view">
        <field name="name">axsync.wip.scrap.graph</field>
        <field name="model">axsync.wip.scrap</field>
        <field name="arch" type="xml">
            <graph string="Scrap Analysis" type="bar" sample="1">
                <field name="product_id"/>
                <field name="scrap_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="axsync_wip_scrap_action" model="ir.actions.act_window">
        <field name="name">Scrap Analysis</field>
        <field name="res_model">axsync.wip.scrap</field>
        <field name="view_mode">tree,pivot,graph</field>
    </record>
</odoo>
